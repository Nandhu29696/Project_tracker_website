# =============================================================================
#  Project Tracker - environment configuration
#  Copy to `.env` and fill in values. NEVER commit `.env`.
#  Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

# ---- App ---------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Port the API listens on
PORT=4000
# Public URL of the web app (used for links in emails and OAuth redirects)
APP_URL=http://localhost:5173
# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Number of trusted proxy hops in front of the API (Vite dev proxy or nginx = 1). 0 = direct access
TRUST_PROXY=1

# ---- PostgreSQL ----------------------------------------------------------------
DB_USER=tracker
DB_PASSWORD=change_me
DB_NAME=project_tracker
# Host port mapped to the Postgres container (5433 avoids clashing with a local install)
DB_HOST_PORT=5433
# Used when running the API directly on your machine (docker-compose overrides it)
DATABASE_URL=postgresql://tracker:change_me@localhost:5433/project_tracker?schema=public

# ---- Auth / security -------------------------------------------------------------
# Min 32 characters, random
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=project-tracker
JWT_AUDIENCE=project-tracker-web
REFRESH_TOKEN_TTL_DAYS=7
# Used to sign short-lived cookies (OAuth state). Min 32 characters, random
COOKIE_SECRET=change_me_to_another_long_random_string_min_32
# true in production (HTTPS only cookies)
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
# Users must click the email link before they can log in with a password
REQUIRE_EMAIL_VERIFICATION=true
# false = invite-only (admins create users)
ALLOW_SELF_REGISTRATION=true
# Requests per 15 min per IP on login/register/forgot-password
AUTH_RATE_LIMIT=20

# ---- Google OAuth2 (optional - Google button is hidden when empty) ---------------
# https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback
# Optional comma separated list e.g. mycompany.com - empty = any Google account
GOOGLE_ALLOWED_DOMAINS=

# ---- Email (SMTP) ----------------------------------------------------------------
MAIL_ENABLED=true
# smtp = send via SMTP_* below | file = save emails to apps/api/.mail-outbox (no mail server needed)
MAIL_TRANSPORT=smtp
MAIL_FROM="Project Tracker <no-reply@project-tracker.local>"
# Dev: Mailpit container (UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Gmail example:     SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=you@gmail.com SMTP_PASS=<app password>
# SendGrid example:  SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_SECURE=false SMTP_USER=apikey SMTP_PASS=<api key>

# ---- Credentials vault - 32 random bytes, base64 ----------------------------------
# Encrypts every stored secret. BACK IT UP: if it is lost, stored secrets cannot be recovered.
# Never change it while secrets exist (re-encryption would be needed). Empty = vault disabled.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_ENCRYPTION_KEY=

# ---- Attachments ----------------------------------------------------------------
# Folder for work item attachments (relative to apps/api, or absolute). Max 10 MB per file.
UPLOAD_DIR=uploads

# ---- Seed: first admin account (npm run db:seed) ---------------------------------
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@123

# ---- Web (Vite) ------------------------------------------------------------------
# Where the Vite dev server proxies /api requests (docker-compose sets http://api:4000)
API_PROXY_TARGET=http://localhost:4000
